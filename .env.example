DEBUG=True
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000
# Razorpay test-mode keys (rzp_test_...) from https://dashboard.razorpay.com/app/keys
# Leave blank to use the built-in simulated checkout (dev only).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
DEFAULT_FROM_EMAIL=Alcove <no-reply@alcove.local>

# Map tiles (defaults to OpenStreetMap; set a provider URL for production)
# MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# Email via Brevo SMTP (leave BREVO_SMTP_KEY empty to use Mailpit in dev).
# DEFAULT_FROM_EMAIL must be a sender verified in Brevo.
BREVO_SMTP_SERVER=smtp-relay.brevo.com
BREVO_MAIL_PORT=587
BREVO_LOGIN=
BREVO_SMTP_KEY=

# When running Django on the host against the Docker services:
# DATABASE_URL=postgis://alcove:alcove@localhost:5433/alcove
# REDIS_URL=redis://localhost:6380
