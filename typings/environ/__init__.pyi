"""Type stubs for django-environ.

django-environ ships only partial annotations: methods such as ``Env.__call__``,
``Env.list`` and ``Env.db_url`` declare ``default=NOTSET`` without a type, so
Pylance/Pyright infer the parameter as ``NoValue`` and reject every real default.
Pylance picks up stubs from ``typings/`` automatically (``python.analysis.stubPath``).
"""

import pathlib
from collections.abc import Callable, Mapping, MutableMapping
from typing import IO, Any, ClassVar, TypeVar, overload

from django.core.exceptions import ImproperlyConfigured as ImproperlyConfigured

__version__: str

_T = TypeVar("_T")

class NoValue: ...
_str = str
_bytes = bytes
_bool = bool
_int = int
_float = float
_list = list
_tuple = tuple
_dict = dict



class Env:
    ENVIRON: ClassVar[MutableMapping[_str, _str]]
    NOTSET: ClassVar[NoValue]
    BOOLEAN_TRUE_STRINGS: ClassVar[_tuple[_str, ...]]
    DEFAULT_DATABASE_ENV: ClassVar[_str]
    DEFAULT_CACHE_ENV: ClassVar[_str]
    DEFAULT_EMAIL_ENV: ClassVar[_str]
    DEFAULT_SEARCH_ENV: ClassVar[_str]

    scheme: Mapping[_str, Any]
    smart_cast: _bool
    escape_proxy: _bool
    prefix: _str

    def __init__(self, **scheme: Any) -> None: ...
    @overload
    def __call__(
        self,
        var: _str,
        cast: Callable[..., _T],
        default: _T | NoValue = ...,
        parse_default: _bool = ...,
    ) -> _T: ...
    @overload
    def __call__(
        self,
        var: _str,
        cast: None = ...,
        default: Any = ...,
        parse_default: _bool = ...,
    ) -> Any: ...
    def __contains__(self, var: _str) -> _bool: ...
    def str(
        self,
        var: _str,
        default: _str | NoValue = ...,
        multiline: _bool = ...,
        choices: Any = ...,
    ) -> _str: ...
    def bytes(
        self, var: _str, default: _bytes | NoValue = ..., encoding: _str = ...
    ) -> _bytes: ...
    def bool(self, var: _str, default: _bool | NoValue = ...) -> _bool: ...
    def int(self, var: _str, default: _int | NoValue = ...) -> _int: ...
    def float(self, var: _str, default: _float | NoValue = ...) -> _float: ...
    def json(self, var: _str, default: Any = ...) -> Any: ...
    def list(
        self, var: _str, cast: Any = ..., default: _list[Any] | NoValue = ...
    ) -> _list[Any]: ...
    def tuple(
        self, var: _str, cast: Any = ..., default: _tuple[Any, ...] | NoValue = ...
    ) -> _tuple[Any, ...]: ...
    def dict(
        self, var: _str, cast: Any = ..., default: _dict[Any, Any] | NoValue = ...
    ) -> _dict[Any, Any]: ...
    def url(self, var: _str, default: _str | NoValue = ...) -> Any: ...
    def db_url(
        self, var: _str = ..., default: _str | NoValue = ..., engine: _str | None = ...
    ) -> _dict[_str, Any]: ...
    def db(
        self, var: _str = ..., default: _str | NoValue = ..., engine: _str | None = ...
    ) -> _dict[_str, Any]: ...
    def cache_url(
        self, var: _str = ..., default: _str | NoValue = ..., backend: _str | None = ...
    ) -> _dict[_str, Any]: ...
    def cache(
        self, var: _str = ..., default: _str | NoValue = ..., backend: _str | None = ...
    ) -> _dict[_str, Any]: ...
    def email_url(
        self, var: _str = ..., default: _str | NoValue = ..., backend: _str | None = ...
    ) -> _dict[_str, Any]: ...
    def email(
        self, var: _str = ..., default: _str | NoValue = ..., backend: _str | None = ...
    ) -> _dict[_str, Any]: ...
    def search_url(
        self, var: _str = ..., default: _str | NoValue = ..., engine: _str | None = ...
    ) -> _dict[_str, Any]: ...
    def path(self, var: _str, default: Any = ..., **kwargs: Any) -> Path: ...
    def get_value(
        self,
        var: _str,
        cast: Any = ...,
        default: Any = ...,
        parse_default: _bool = ...,
    ) -> Any: ...
    @classmethod
    def read_env(
        cls,
        env_file: _str | pathlib.Path | IO[_str] | None = ...,
        overwrite: _bool = ...,
        parse_comments: _bool = ...,
        encoding: _str = ...,
        **overrides: Any,
    ) -> None: ...

class FileAwareEnv(Env): ...

class Path:
    def __init__(self, start: str = ..., *paths: str, **kwargs: Any) -> None: ...
    def __call__(self, *paths: str, **kwargs: Any) -> str: ...
    def path(self, *paths: str, **kwargs: Any) -> Path: ...
    def file(self, name: str, *args: Any, **kwargs: Any) -> IO[Any]: ...
    @property
    def root(self) -> str: ...
    def __add__(self, other: object) -> Path: ...
    def __sub__(self, other: object) -> Path: ...
    def __fspath__(self) -> str: ...
